# Create a free Firebase project at https://console.firebase.google.com
# Enable: Authentication -> Sign-in method -> Anonymous
# Enable: Firestore Database (start in production mode, then paste firestore.rules)
# Enable: Storage (paste storage.rules)
# Project settings -> General -> Your apps -> Web app -> copy config below

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
